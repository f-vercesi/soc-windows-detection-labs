# LAB 1 - Brute Force Detection
#
# Purpose:
# Detect repeated failed authentication attempts within
# a five-minute time window.
#
# Event:
# 4625 - Failed logon
#
# Detection concept:
# One source -> one target account -> multiple failures
#
# Threshold used in this lab:
# 5 or more failures within a 5-minute bucket.

index=lab1_windows sourcetype="XmlWinEventLog:Security"
| rex "<EventID>(?<EventID>\d+)</EventID>"
| rex "<Data Name='TargetUserName'>(?<TargetUserName>[^<]+)</Data>"
| rex "<Data Name='LogonType'>(?<LogonType>\d+)</Data>"
| rex "<Data Name='IpAddress'>(?<IpAddress>[^<]+)</Data>"
| search EventID=4625
| bin _time span=5m
| stats count by _time TargetUserName IpAddress LogonType
| where count >= 5
| sort - _time