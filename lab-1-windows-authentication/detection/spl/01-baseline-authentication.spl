# LAB 1 - Baseline Authentication
#
# Purpose:
# Establish a baseline of successful Windows authentication events
# before intentional authentication attack activity is generated.
#
# Event:
# 4624 - Successful logon
#
# Fields extracted:
# - EventID
# - TargetUserName
# - LogonType
# - IpAddress
#
# Analyst objective:
# Determine what normal authentication activity is visible
# during the baseline period.

index=lab1_windows sourcetype="XmlWinEventLog:Security"
| rex "<EventID>(?<EventID>\d+)</EventID>"
| rex "<Data Name='TargetUserName'>(?<TargetUserName>[^<]+)</Data>"
| rex "<Data Name='LogonType'>(?<LogonType>\d+)</Data>"
| rex "<Data Name='IpAddress'>(?<IpAddress>[^<]+)</Data>"
| search EventID=4624
| stats count by LogonType TargetUserName
| sort - count