# LAB 1 - Password Spray Detection
#
# Purpose:
# Identify a source IP targeting multiple accounts with
# failed authentication attempts.
#
# Event:
# 4625 - Failed logon
#
# Detection concept:
# One source -> multiple target accounts -> distributed failures
#
# Detection logic:
# Count distinct target accounts per source IP.
#
# Threshold used in this lab:
# 3 or more distinct target accounts.

index=lab1_windows sourcetype="XmlWinEventLog:Security"
| rex "<EventID>(?<EventID>\d+)</EventID>"
| rex "<Data Name='TargetUserName'>(?<TargetUserName>[^<]+)</Data>"
| rex "<Data Name='IpAddress'>(?<IpAddress>[^<]+)</Data>"
| search EventID=4625
| stats dc(TargetUserName) as distinct_accounts
        count as total_failures
        values(TargetUserName) as targeted_accounts
        min(_time) as first_seen
        max(_time) as last_seen
        by IpAddress
| where distinct_accounts >= 3
| convert ctime(first_seen) ctime(last_seen)