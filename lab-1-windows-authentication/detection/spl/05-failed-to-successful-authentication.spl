# LAB 1 - Failed-to-Successful Authentication Correlation
#
# Purpose:
# Investigate authentication failures followed by
# successful authentication for the same account and source.
#
# Events:
# 4625 - Failed logon
# 4624 - Successful logon
#
# Analyst objective:
# Determine whether repeated authentication failures
# were followed by a successful authentication.

index=lab1_windows sourcetype="XmlWinEventLog:Security"
| rex "<EventID>(?<EventID>\d+)</EventID>"
| rex "<Data Name='TargetUserName'>(?<TargetUserName>[^<]+)</Data>"
| rex "<Data Name='LogonType'>(?<LogonType>\d+)</Data>"
| rex "<Data Name='IpAddress'>(?<IpAddress>[^<]+)</Data>"
| rex "<Data Name='WorkstationName'>(?<WorkstationName>[^<]+)</Data>"
| search (EventID=4624 OR EventID=4625)
    TargetUserName="labuser01"
    IpAddress="192.168.56.102"
| table _time EventID TargetUserName LogonType IpAddress WorkstationName
| sort _time